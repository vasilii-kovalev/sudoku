{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "es2023",
		"module": "ESNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		// Oxlint checks unused locals and allows names starting with "_"; TypeScript cannot configure that exception.
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["scripts", "vite.config.ts", "oxlint.config.ts", "oxfmt.config.ts"]
}
